# Firecrawl — product page scraping & extraction
FIRECRAWL_API_KEY=

# Google Gemini 2.5 Flash — LLM for trust scoring & analysis (free tier during MVP)
GEMINI_API_KEY=

# Apify — Reddit scraping via FREE Reddit Scraper Pro actor (no Reddit API credentials needed)
APIFY_API_TOKEN=

# Database — PostgreSQL connection string
DATABASE_URL=

# FDA — adverse event lookups (api.fda.gov)
FDA_API_KEY=

# NCBI — PubMed E-utilities for ingredient evidence
NCBI_API_KEY=

# Scrapaholic — simple password auth for private access
SCRAPAHOLIC_PASSWORD=

# Sunshower — Mapbox Static Images (bed-planner satellite underlay; Phase-2 range map later)
# Browser-exposed (NEXT_PUBLIC_): restrict the token by URL to production domain + localhost
# in the Mapbox dashboard. Unset = the app falls back to keyless USGS NAIP imagery.
NEXT_PUBLIC_MAPBOX_TOKEN=
