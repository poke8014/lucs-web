# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# firecrawl local scrape cache
/.firecrawl

# obsidian — keep vault config tracked, but ignore UI state and trash
vault/.obsidian/workspace*.json
vault/.obsidian/cache
vault/.obsidian/appearance.json.bak
vault/.trash/

# vault image binaries — large, regeneratable via fetch scripts.
# metadata.json sidecars are NOT ignored — they encode attribution + source IDs.
vault/raw/assets/**/*.jpg
vault/raw/assets/**/*.JPG
vault/raw/assets/**/*.jpeg
vault/raw/assets/**/*.png

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
